# https://editorconfig.org
# Windows PowerShell 5.1 reads UTF-8 files without a byte order mark as ANSI
# and garbles every non-ASCII character in the output. utf-8-bom is therefore
# required, not a style preference.
root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
